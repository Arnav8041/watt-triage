# Copy this file to .env and fill in the two CHANGE_ME placeholders. See README.md for the
# exact commands that create the role and databases these connect to.

# --- Required: the app refuses to start without these. ---

# Main database. Role/database created in the README's setup steps.
DATABASE_URL=postgresql://watt:CHANGE_ME@localhost:5432/watt

# A second, separate database so the test suite can wipe tables freely without ever touching
# dev data. Same role, different database name.
TEST_DATABASE_URL=postgresql://watt:CHANGE_ME@localhost:5432/watt_test

# The triage agent's model calls. Get a key at https://console.anthropic.com/ — never commit
# a real one; this file only ever holds a placeholder.
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Shared secret required on write endpoints: POST /readings and POST /admin/rollup (ADR-0006,
# ticket #15). The app fails closed — it will not start at all if this is unset. Any random
# string works for local development.
WRITE_API_KEY=CHANGE_ME

# --- Optional: every one of these already has a sensible default in code (shown below). ---

# Browser origins allowed to call the API, comma-separated. Empty means none. Set this to
# wherever the dashboard runs, e.g. http://localhost:3000, once you start it.
CORS_ORIGINS=

# Seconds the demo's "fire a scenario" button is disabled after firing, so a crowd mashing it
# can't spam paid model calls. Default: 10
# FIRE_COOLDOWN_SECONDS=10

# Hours of raw Readings kept before /admin/rollup summarises and deletes them. Default: 24
# RETENTION_HOURS=24

# The triage agent (app/agent.py). Defaults: claude-haiku-4-5, 30s, 6 turns, 100 runs/hour.
# AGENT_MODEL=claude-haiku-4-5
# AGENT_TIMEOUT_SECONDS=30
# AGENT_MAX_TURNS=6
# AGENT_MAX_RUNS_PER_HOUR=100

# The gate's deterministic rules (app/gate.py). Defaults: 0.8, 24
# GATE_HEADROOM_FRACTION=0.8
# GATE_COOLDOWN_HOURS=24

# The statistical detector (app/detector.py). Defaults: 120, 3, 4.0, 30
# DETECTOR_WINDOW=120
# DETECTOR_PERSISTENCE=3
# DETECTOR_Z_THRESHOLD=4.0
# DETECTOR_MIN_BASELINE=30

# Base URL the standalone simulator CLI posts Readings to (app/simulator.py's `ambient`/`fire`
# commands only — the API itself never reads this). Default: http://localhost:8000
# SIMULATOR_API_URL=http://localhost:8000
